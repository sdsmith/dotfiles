#!/usr/bin/env bash

# Diffs each layer in a graphite stack.
# Requires Graphite (gt).

branches=($(gt log short --stack | grep -E '◯|◉' | awk '{print $2}' | tac))
for i in "${!branches[@]}"; do
  [[ $i -eq 0 ]] && continue
  base="${branches[$i-1]}"
  tip="${branches[$i]}"
  echo "=== $tip ==="
  git diff --stat "$base".."$tip"
  echo
done
